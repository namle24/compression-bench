# Experiment parameters. Any variable can be overridden from the environment,
# e.g.  SIZES="1 2" APPS=sort REPS=1 ./run_experiments.sh
: "${MASTER:=master}"
: "${WORKERS:=worker1 worker2 worker3}"
: "${SIZES:=1 2 4 8}"
: "${CODECS:=snappy lz4 gzip zstd}"
: "${CONFIGS:=C1 C2 C3}"
: "${APPS:=sort hashscore bigram}"
: "${REPS:=3}"
: "${REDUCERS:=6}"
: "${HASH_ROUNDS:=200}"
: "${HDFS_ROOT:=/bench}"
: "${RESULTS:=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/results}"
: "${JAR:=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/apps/compression-apps.jar}"
: "${JHS:=http://$MASTER:19888}"
: "${HADOOP_HOME:=/opt/hadoop}"

NODES="$MASTER $WORKERS"
export PATH=$HADOOP_HOME/bin:$PATH
